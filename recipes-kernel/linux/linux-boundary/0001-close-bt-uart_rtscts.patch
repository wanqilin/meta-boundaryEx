Subject: [PATCH] close bt uart_rtscts

---
 arch/arm64/boot/dts/freescale/imx8mp-nitrogen8mp-som.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-nitrogen8mp-som.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-nitrogen8mp-som.dtsi
index d995a70ee6b4..6cf32544e943 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-nitrogen8mp-som.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-nitrogen8mp-som.dtsi
@@ -537,7 +537,7 @@ &uart1 { /* BT */
 	pinctrl-0 = <&pinctrl_uart1>;
 	assigned-clocks = <&clk IMX8MP_CLK_UART1>;
 	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
-	uart-has-rtscts;
+	/*uart-has-rtscts;*/
 	status = "okay";
 };
 
